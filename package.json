{
  "name": "ultra-max-monorepo",
  "private": true,
  "description": "Ultra Max WooCommerce theme and companion plugins.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/ui"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "setup": "node scripts/setup.mjs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "env:start": "node scripts/env.mjs start",
    "env:stop": "node scripts/env.mjs stop",
    "env:reset": "node scripts/env.mjs reset",
    "env:logs": "node scripts/env.mjs logs",
    "wp": "node scripts/env.mjs cli",
    "composer": "node scripts/composer.mjs",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:boundaries && npm run lint:php && npm run analyse:php",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:boundaries": "node scripts/lint-boundaries.mjs",
    "lint:php": "node scripts/composer.mjs exec -- phpcs",
    "lint:php:fix": "node scripts/composer.mjs exec -- phpcbf",
    "analyse:php": "node scripts/composer.mjs exec -- phpstan analyse --memory-limit=1G",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:unit && npm run test:php && npm run test:e2e",
    "test:unit": "vitest run",
    "test:php": "docker compose run --rm cli php wp-content/ultra-max-dev/vendor/bin/phpunit -c wp-content/ultra-max-dev/phpunit.xml.dist",
    "test:e2e": "playwright test",
    "test:visual:update": "node scripts/playwright-docker.mjs --update-snapshots",
    "check:wp": "node scripts/wp-checks.mjs",
    "i18n": "node scripts/i18n.mjs",
    "help:pdf": "node scripts/help-pdf.mjs",
    "package": "node scripts/package.mjs",
    "test:package": "node scripts/test-package.mjs",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "overrides": {
    "playwright-core": "1.64.1",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.0.0",
    "marked": "18.1.1",
    "postcss": "8.5.31",
    "rtlcss": "4.3.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "yazl": "3.3.1"
  }
}
