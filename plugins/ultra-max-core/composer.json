{
  "name": "ultra-max/ultra-max-core",
  "description": "Layout builder, Elementor widgets, store modules and demo importer for the Ultra Max theme.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "UltraMax\\Core\\": "src/"
    },
    "classmap": [
      "vendor-prefixed/"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "platform": {
      "php": "8.1.0"
    }
  }
}
