{
  "name": "ultra-max/ultra-max-invoice",
  "description": "Invoices, shipping labels and order documents for WooCommerce.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "UltraMax\\Invoice\\": "src/"
    },
    "classmap": [
      "vendor-prefixed/"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "platform": {
      "php": "8.1.0"
    }
  }
}