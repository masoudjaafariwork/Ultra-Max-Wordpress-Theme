{
  "name": "ultra-max/theme",
  "description": "Ultra Max storefront theme.",
  "type": "wordpress-theme",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "UltraMax\\Theme\\": "src/"
    },
    "classmap": [
      "vendor-prefixed/"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "platform": {
      "php": "8.1.0"
    }
  }
}